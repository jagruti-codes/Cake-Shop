@model List<cake_shop.Models.Product>

@{
    ViewData["Title"] = "Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- SWEETALERT CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- SUCCESS ALERT (ADD / EDIT / DELETE) -->
@if (TempData["success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@TempData["success"]',
                showConfirmButton: false,
                timer: 2000
            });
        });
    </script>
}

<!-- PAGE HEADER -->
<div class="page-header">

    <div class="page-title">
        <h2>Manage Products</h2>
        <p>Create, edit, and track your bakery inventory</p>
    </div>

    <div class="header-actions">
        <a asp-action="AddProduct" class="action-btn primary">
            + Add New Product
        </a>
    </div>

</div>

<!-- TABLE PANEL -->
<div class="panel">

    <!-- SEARCH + FILTER -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; gap:10px;">

        <div class="search" style="flex:1;">
            <i class="fa fa-search"></i>
            <input type="text" id="searchBox" placeholder="Search product..." />
        </div>

        <select id="statusFilter" class="status-dropdown">
            <option value="all">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>

    </div>

    <!-- TABLE -->
    <table id="productTable">

        <thead>
            <tr>
                <th>ID</th>
                <th>IMAGE</th>
                <th>PRODUCT NAME</th>
                <th>DESCRIPTION</th>
                <th>CATEGORY</th>
                <th>PRICE</th>
                <th>STOCK</th>
                <th>STATUS</th>
                <th>ACTIONS</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>#PRD-@item.Id</td>

                        <td>
                            <img src="@item.ImagePath" width="40" height="40"
                                 style="border-radius:6px; object-fit:cover;" />
                        </td>

                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.Category?.Name</td>
                        <td>₹@item.Price</td>
                        <td>@item.Stock</td>

                        <td>
                            <span class="status @(item.Status?.ToLower() == "active" ? "delivered" : "processing")">
                                @item.Status
                            </span>
                        </td>

                        <td class="actions">

                            <!-- EDIT -->
                            <a asp-action="EditProduct" asp-route-id="@item.Id">
                                <i class="fa fa-pen edit"></i>
                            </a>

                            <!-- DELETE -->
                            <a href="javascript:void(0);" onclick="confirmDelete(@item.Id)">
                                <i class="fa fa-trash delete"></i>
                            </a>

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" style="text-align:center;">No products found</td>
                </tr>
            }

        </tbody>

    </table>

</div>

<!-- FILTER SCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("searchBox").addEventListener("keyup", filterTable);
        document.getElementById("statusFilter").addEventListener("change", filterTable);
    });

    function filterTable() {

        let search = document.getElementById("searchBox").value.toLowerCase().trim();
        let statusFilter = document.getElementById("statusFilter").value.toLowerCase().trim();

        let rows = document.querySelectorAll("#productTable tbody tr");

        rows.forEach(row => {

            let name = row.cells[2]?.innerText.toLowerCase().trim() || "";
            let desc = row.cells[3]?.innerText.toLowerCase().trim() || "";
            let status = row.cells[7]?.innerText.toLowerCase().trim() || "";

            let matchSearch =
                name.includes(search) ||
                desc.includes(search);

            let matchStatus =
                statusFilter === "all" ||
                status === statusFilter;

            row.style.display = (matchSearch && matchStatus) ? "" : "none";
        });
    }
</script>

<!-- DELETE CONFIRMATION -->
<script>
    function confirmDelete(id) {
        Swal.fire({
            title: 'Delete Product?',
            text: "This product will be permanently deleted!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ff4d6d',
            cancelButtonColor: '#aaa',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/Admin/DeleteProduct/' + id;
            }
        });
    }
</script>
