
@model List<cake_shop.Models.Category>

@{
    ViewData["Title"] = "Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- SWEETALERT CDN  -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- SUCCESS ALERT (ADD / EDIT / DELETE) -->
@if (TempData["success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@TempData["success"]',
                showConfirmButton: false,
                timer: 2000
            });
        });
    </script>
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title">
        <h2>Manage Categories</h2>
        <p>Manage bakery categories</p>
    </div>

    <div class="header-actions">
        <a asp-action="AddCategory" class="action-btn primary">
            + Add Category
        </a>
    </div>
</div>

<!-- TABLE PANEL -->
<div class="panel">

    <!-- SEARCH + FILTER -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; gap:10px;">

        <div class="search" style="flex:1;">
            <i class="fa fa-search"></i>
            <input type="text" id="searchBox" placeholder="Search categories..." />
        </div>

        <select id="statusFilter" class="status-dropdown">
            <option value="all">All Status</option>
            <option value="active">🟢 Active</option>
            <option value="inactive">🔴 Inactive</option>
        </select>

    </div>

    <!-- TABLE -->
    <table id="categoryTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>IMAGE</th>
                <th>CATEGORY NAME</th>
                <th>DESCRIPTION</th>
                <th>ITEMS</th>
                <th>STATUS</th>
                <th>ACTIONS</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>#CAT-@item.Id</td>

                    <td>
                        <img src="@item.ImagePath"
                             style="width:40px;height:40px;border-radius:6px;" />
                    </td>

                    <td>@item.Name</td>

                    <td>@item.Description</td>

                    <td>@item.ItemCount</td>

                    <td>
                        <span class="status @(item.IsActive ? "delivered" : "processing")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>

                    <td class="actions">

                        <!-- EDIT -->
                        <a asp-action="EditCategory" asp-route-id="@item.Id">
                            <i class="fa fa-pen edit"></i>
                        </a>

                        <!-- DELETE -->
                        <a href="javascript:void(0);" onclick="confirmDelete(@item.Id)">
                            <i class="fa fa-trash delete"></i>
                        </a>

                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>

<!-- SEARCH + FILTER SCRIPT -->
<script>
    document.getElementById("searchBox").addEventListener("keyup", filterTable);
    document.getElementById("statusFilter").addEventListener("change", filterTable);

    function filterTable() {

        let search = document.getElementById("searchBox").value.toLowerCase();
        let statusFilter = document.getElementById("statusFilter").value.toLowerCase();

        let rows = document.querySelectorAll("#categoryTable tbody tr");

        rows.forEach(row => {

            let text = row.innerText.toLowerCase();
            let status = row.cells[5].innerText.toLowerCase().trim();

            let matchSearch = text.includes(search);

            let matchStatus =
                statusFilter === "all" ||
                status === statusFilter;

            row.style.display = (matchSearch && matchStatus) ? "" : "none";
        });
    }
</script>

<!-- DELETE CONFIRMATION (SWEETALERT) -->
<script>
    function confirmDelete(id) {
        Swal.fire({
            title: 'Delete Category?',
            text: "This category will be permanently deleted!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ff4d6d',
            cancelButtonColor: '#aaa',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/Admin/DeleteCategory/' + id;
            }
        });
    }
</script>
