            </div>

            <div class="contact-highlight">
                <h4>Custom Cake Consultation</h4>
                <p>Need design help? Our pastry team can guide you on theme, layers, and serving size.</p>
                <a href="/Home/Cakes" class="btn btn-dark">View Cake Menu</a>
            </div>
        </aside> *@
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
