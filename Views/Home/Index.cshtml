@{
    ViewData["Title"] = "Home";
}

<div class="home-v2">
    <section class="home-hero">
        <div class="home-hero__content">
            <p class="home-eyebrow">SweetCake Signature Bakery</p>
            <h1>Crafted cakes that make every celebration unforgettable.</h1>
            <p>
                From elegant wedding tiers to playful birthday creations, we bake fresh every day using premium ingredients and artisan techniques.
            </p>
            <div class="home-hero__actions">
                <a href="/Home/Cakes" class="btn btn-danger btn-lg">Explore Cakes</a>
                <a href="/Home/Contact" class="btn btn-outline-dark btn-lg">Book a Custom Order</a>
            </div>
            <div class="home-hero__stats">
                <div>
                    <span>3000+</span>
                    <p>Cakes Delivered</p>
                </div>
                <div>
                    <span>4.9/5</span>
                    <p>Customer Rating</p>
                </div>
                <div>
                    <span>Same Day</span>
                    <p>City Delivery</p>
                </div>
            </div>
        </div>
        <div class="home-hero__visual">
            <img src="/images/bakery.jpg" alt="Signature bakery cake display" />
            <div class="hero-note">
                <i class="fa-solid fa-award"></i>
                <span>Handcrafted with love since 1999</span>
            </div>
        </div>
    </section>

    <section class="home-features">
        <article>
            <i class="fa-solid fa-cake-candles"></i>
            <h3>Freshly Baked</h3>
            <p>Daily-baked sponge and mousse cakes with rich, balanced flavors.</p>
        </article>
        <article>
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <h3>Custom Design</h3>
            <p>Theme cakes tailored for birthdays, weddings, and corporate events.</p>
        </article>
        <article>
            <i class="fa-solid fa-truck-fast"></i>
            <h3>Fast Delivery</h3>
            <p>Carefully packed and delivered on time across the city.</p>
        </article>
        <article>
            <i class="fa-solid fa-heart"></i>
            <h3>Made with Care</h3>
            <p>Every order is prepared by our pastry team with premium ingredients.</p>
        </article>
    </section>

    <section class="home-categories">
        <div class="section-head">
            <p class="home-eyebrow">Popular Collections</p>
            <h2>Find the perfect cake for your next occasion</h2>
        </div>
        <div class="category-grid">
            <a href="/Home/Cakes" class="category-card">
                <img src="/images/birthday3.jpg" alt="Birthday cakes" />
                <div>
                    <h4>Birthday Cakes</h4>
                    <p>Fun, colorful and personalized celebration cakes.</p>
                </div>
            </a>
            <a href="/Home/Cakes" class="category-card">
                <img src="/images/birthday5.jpg" alt="Chocolate cakes" />
                <div>
                    <h4>Chocolate Specials</h4>
                    <p>Rich ganache, truffle textures and dark chocolate delights.</p>
                </div>
            </a>
            <a href="/Home/Cakes" class="category-card">
                <img src="/images/birthday6.jpg" alt="Wedding cakes" />
                <div>
                    <h4>Elegant Event Cakes</h4>
                    <p>Luxury cakes for weddings, anniversaries, and milestone events.</p>
                </div>
            </a>
        </div>
    </section>

    <section class="home-cta">
        <h2>Need a cake designed exactly your way?</h2>
        <p>Share your idea and our bakery team will prepare a custom quote quickly.</p>
        <a href="/Home/Contact" class="btn btn-dark btn-lg">Talk to SweetCake</a>
    </section>

</div>
