@{
    ViewData["Title"] = "About";
}

<div class="about-v2">
    <section class="about-hero-v2">
        <div class="about-hero-content">
            <p class="home-eyebrow">Our Bakery Story</p>
            <h1>Crafting cakes that make every celebration sweeter</h1>
            <p>
                SweetCake began with one goal: create handcrafted cakes that taste as beautiful as they look.
                Today, we combine classic baking techniques with modern designs to deliver unforgettable desserts.
            </p>
            <div class="about-badges">
                <span>Fresh Ingredients</span>
                <span>Custom Designs</span>
                <span>Trusted by Families</span>
            </div>
        </div>
        <div class="about-hero-image">
            <img src="/images/bakery.jpg" alt="SweetCake bakery team" />
        </div>
    </section>

    <section class="about-values">
        <article>
            <i class="fa-solid fa-seedling"></i>
            <h3>Quality First</h3>
            <p>We use premium ingredients and fresh cream for every order.</p>
        </article>
        <article>
            <i class="fa-solid fa-palette"></i>
            <h3>Creative Designs</h3>
            <p>From elegant wedding tiers to fun birthday themes, every cake is personalized.</p>
        </article>
        <article>
            <i class="fa-solid fa-user-group"></i>
            <h3>Customer Happiness</h3>
            <p>Our team works closely with you to match flavor, style, and event mood.</p>
        </article>
    </section>

    <section class="about-journey">
        <div class="section-head">
            <p class="home-eyebrow">Journey</p>
            <h2>How SweetCake grew over the years</h2>
        </div>
        <div class="journey-grid">
            <article>
                <h4>1999</h4>
                <p>Started as a small neighborhood bakery with handmade celebration cakes.</p>
            </article>
            <article>
                <h4>2010</h4>
                <p>Expanded custom cake services for birthdays, anniversaries, and corporate events.</p>
            </article>
            <article>
                <h4>2020</h4>
                <p>Introduced online ordering and fast doorstep delivery across the city.</p>
            </article>
            <article>
                <h4>Today</h4>
                <p>Serving thousands of happy customers with signature flavors and artistic designs.</p>
            </article>
        </div>
    </section>

    <section class="about-cta-v2">
        <h2>Planning a special event?</h2>
        <p>Let SweetCake design a cake that matches your celebration perfectly.</p>
        <a href="/Home/Contact" class="btn btn-danger">Talk to Our Team</a>
    </section>
</div>
