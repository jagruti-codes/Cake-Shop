@model List<cake_shop.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📦 My Orders</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No orders found.
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="card mb-4 shadow-sm border-0">

                <!-- ORDER HEADER -->
                <div class="card-header bg-light d-flex justify-content-between align-items-center">

                    <div>
                        <b>Order #@order.Id</b>
                        <div class="text-muted small">
                            @order.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt")
                        </div>
                    </div>

                    <div class="text-end">

                        <!-- STATUS BADGE -->
                        @if (order.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else if (order.Status == "Delivered")
                        {
                            <span class="badge bg-success">Delivered</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@order.Status</span>
                        }

                        <!-- CANCEL BUTTON -->
                        @if (order.Status != "Cancelled")
                        {
                            <div class="mt-2">
                                <a asp-action="CancelOrder"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Cancel this order?');">
                                    Cancel Order
                                </a>
                            </div>
                        }

                    </div>

                </div>

                <!-- ORDER BODY -->
                <div class="card-body">

                    <p class="mb-2">
                        <b>Total:</b> ₹@order.TotalAmount
                    </p>

                    <hr />

                    <!-- ITEMS -->
                    @foreach (var item in order.Items)
                    {
                        <div class="d-flex align-items-center mb-3">

                            <img src="@item.Product?.ImagePath"
                                 style="width:50px;height:50px;object-fit:cover;border-radius:8px;border:1px solid #ddd;" />

                            <div class="ms-3 flex-grow-1">
                                <div class="fw-bold">@item.Product?.Name</div>
                                <small class="text-muted">
                                    ₹@item.Price × @item.Quantity
                                </small>
                            </div>

                            <div class="fw-bold">
                                ₹@(item.Price* item.Quantity)
                            </div>

                        </div>
                    }


                </div>

            </div>
        }
    }

</div> *@



@* @model List<cake_shop.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<style>
    /* ⭐ STAR RATING UI */
    .rating {
        direction: rtl;
        unicode-bidi: bidi-override;
        display: inline-flex;
        margin-top: 5px;
    }

        .rating input {
            display: none;
        }

        .rating label {
            font-size: 22px;
            color: #ccc;
            cursor: pointer;
            transition: 0.2s;
            margin-right: 2px;
        }

            .rating label:hover,
            .rating label:hover ~ label,
            .rating input:checked ~ label {
                color: gold;
            }

    .review-box {
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 6px;
    }
</style>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📦 My Orders</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No orders found.
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="card mb-4 shadow-sm border-0">

                <!-- ORDER HEADER -->
                <div class="card-header bg-light d-flex justify-content-between align-items-center">

                    <div>
                        <b>Order #@order.Id</b>
                        <div class="text-muted small">
                            @order.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt")
                        </div>
                    </div>

                    <div class="text-end">

                        @if (order.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else if (order.Status == "Delivered")
                        {
                            <span class="badge bg-success">Delivered</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@order.Status</span>
                        }

                        @if (order.Status != "Cancelled")
                        {
                            <div class="mt-2">
                                <a asp-action="CancelOrder"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Cancel this order?');">
                                    Cancel Order
                                </a>
                            </div>
                        }

                    </div>

                </div>

                <!-- ORDER BODY -->
                <div class="card-body">

                    <p class="mb-3">
                        <b>Total:</b> ₹@order.TotalAmount
                    </p>

                    <hr />

                    <!-- ITEMS -->
                    @foreach (var item in order.Items)
                    {
                        <div class="d-flex align-items-start mb-4">

                            <!-- PRODUCT IMAGE -->
                            <img src="@item.Product?.ImagePath"
                                 style="width:55px;height:55px;object-fit:cover;border-radius:8px;border:1px solid #ddd;" />

                            <div class="ms-3 flex-grow-1">

                                <!-- NAME -->
                                <div class="fw-bold">@item.Product?.Name</div>

                                <small class="text-muted">
                                    ₹@item.Price × @item.Quantity
                                </small>

                                <!-- ⭐ REVIEW FORM -->
                                <form asp-action="AddReview"
                                      method="post"
                                      class="mt-2">

                                    <input type="hidden" name="productId" value="@item.ProductId" />

                                    <!-- STAR RATING -->
                                    <div class="rating">
                                        @for (int i = 5; i >= 1; i--)
                                        {
                                            <input type="radio"
                                                   id="star-@item.ProductId-@i"
                                                   name="rating"
                                                   value="@i" />
                                            <label for="star-@item.ProductId-@i">★</label>
                                        }
                                    </div>

                                    <!-- REVIEW TEXT -->
                                    <textarea name="review"
                                  class="form-control mt-2 review-box"
                                  rows="2"
                                  placeholder="Write your review..."></textarea>

                                    <!-- SUBMIT -->
                                    <button type="submit"
                                            class="btn btn-sm btn-primary mt-2">
                                        Submit Review
                                    </button>

                                </form>

                            </div>

                            <!-- PRICE -->
                            <div class="fw-bold">
                                ₹@(item.Price* item.Quantity)
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }

</div>


