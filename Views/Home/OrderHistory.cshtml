@model List<cake_shop.Models.Order>

@{
    ViewData["Title"] = "My Orders";
    var reviews = ViewBag.Reviews as List<cake_shop.Models.RatingReview>;
}

<style>
    .rating {
        direction: rtl;
        unicode-bidi: bidi-override;
        display: inline-flex;
    }

        .rating input {
            display: none;
        }

        .rating label {
            font-size: 20px;
            color: #ccc;
            cursor: pointer;
            margin-right: 2px;
        }

            .rating label:hover,
            .rating label:hover ~ label,
            .rating input:checked ~ label {
                color: gold;
            }
</style>

<div class="container mt-5">

    <h2 class="mb-4">📦 My Orders</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No orders found.
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="card mb-4 shadow-sm border-0">

                <!-- ORDER HEADER -->
                <div class="card-header bg-light d-flex justify-content-between">
                    <div>
                        <b>Order #@order.Id</b><br />
                        <small>@order.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt")</small>
                    </div>

                    <div>
                        @if (order.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else if (order.Status == "Delivered")
                        {
                            <span class="badge bg-success">Delivered</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@order.Status</span>
                        }
                    </div>
                </div>

                <!-- ORDER BODY -->
                <div class="card-body">

                    <p><b>Total:</b> ₹@order.TotalAmount</p>

                    <hr />

                    @foreach (var item in order.Items)
                    {
                        var existingReview = reviews?.FirstOrDefault(r => r.ProductId == item.ProductId);

                        <div class="d-flex align-items-start mb-4">

                            <!-- PRODUCT IMAGE -->
                            <img src="@item.Product?.ImagePath"
                                 style="width:55px;height:55px;border-radius:8px;border:1px solid #ddd;" />

                            <div class="ms-3 flex-grow-1">

                                <!-- PRODUCT NAME -->
                                <div class="fw-bold">@item.Product?.Name</div>

                                <small class="text-muted">
                                    ₹@item.Price × @item.Quantity
                                </small>

                                <!-- ================= REVIEW SECTION ================= -->
                                @if (existingReview != null)
                                {
                                    <!-- SHOW EXISTING REVIEW -->
                                    <div class="mt-2 p-2 border rounded">

                                        <div class="rating">
                                            @for (int i = 5; i >= 1; i--)
                                            {
                                                if (i <= existingReview.Rating)
                                                {
                                                    <label style="color:gold;">★</label>
                                                }
                                                else
                                                {
                                                    <label>★</label>
                                                }
                                            }
                                        </div>

                                        <p class="mb-1">@existingReview.Review</p>

                                       

                                        @if (!existingReview.IsApproved)
                                        {
                                            <button class="btn btn-sm btn-warning"
                                                    onclick="toggleEdit(@existingReview.Id)">
                                                Edit
                                            </button>

                                            <a asp-action="DeleteReview"
                                               asp-route-id="@existingReview.Id"
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Delete review?');">
                                                Delete
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Approved Review
                                            </span>
                                        }


                                        <!-- EDIT FORM -->
                                        <div id="editForm-@existingReview.Id"
                                             style="display:none;"
                                             class="mt-2">

                                            <form asp-action="EditReview" method="post">

                                                <input type="hidden" name="Id" value="@existingReview.Id" />

                                                <div class="rating">
                                                    @for (int i = 5; i >= 1; i--)
                                                    {
                                                        <input type="radio"
                                                               id="edit-star-@existingReview.Id-@i"
                                                               name="Rating"
                                                               value="@i"
                                                               @(existingReview.Rating == i ? "checked" : "") />

                                                        <label for="edit-star-@existingReview.Id-@i">★</label>
                                                    }
                                                </div>

                                                <textarea name="Review"
                                          class="form-control mt-2"
                                          rows="2">@existingReview.Review</textarea>

                                                <button class="btn btn-sm btn-success mt-2">
                                                    Update
                                                </button>

                                            </form>

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <!-- ADD REVIEW FORM -->
                                    <form asp-action="AddReview" method="post" class="mt-2">

                                        <input type="hidden" name="productId" value="@item.ProductId" />

                                        <div class="rating">
                                            @for (int i = 5; i >= 1; i--)
                                            {
                                                <input type="radio"
                                                       id="add-star-@item.ProductId-@i"
                                                       name="rating"
                                                       value="@i" />

                                                <label for="add-star-@item.ProductId-@i">★</label>
                                            }
                                        </div>

                                        <textarea name="review"
                                  class="form-control mt-2"
                                  rows="2"
                                  placeholder="Write your review..."></textarea>

                                        <button type="submit"
                                                class="btn btn-sm btn-primary mt-2">
                                            Submit Review
                                        </button>

                                    </form>
                                }


                            </div>

                            <!-- PRICE -->
                            <div class="fw-bold">
                                ₹@(item.Price* item.Quantity)
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }

</div>

<script>
    function toggleEdit(id) {
        var form = document.getElementById("editForm-" + id);

        if (form.style.display === "none") {
            form.style.display = "block";
        } else {
            form.style.display = "none";
        }
    }
</script>
