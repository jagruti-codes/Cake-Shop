@* @model cake_shop.Models.UserProfileViewModel
@{
    ViewData["Title"] = "User Dashboard";
    var initials = string.Join("", (Model.Name ?? string.Empty)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(part => part[0])
        .Take(2))
        .ToUpperInvariant();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "GU";
    }
}

<div class="dashboard-v2">
    <section class="dashboard-head">
        <p class="home-eyebrow">My Account</p>
        <h1>Welcome Back, @Model.Name</h1>
        <p>Track your orders, favorites, cart, and keep your profile details updated.</p>
    </section>

    <section class="dashboard-grid">
        <aside class="dashboard-menu">
            <h4>User Menu</h4>
            <a href="/Home/Cakes"><i class="fa-solid fa-cake-candles"></i> Browse Cakes</a>
            <a href="/Home/Wishlist"><i class="fa-regular fa-heart"></i> Wishlist</a>
            <a href="/Home/Cart"><i class="fa-solid fa-cart-shopping"></i> Cart</a>
            <a href="/Home/Contact"><i class="fa-solid fa-headset"></i> Contact Support</a>
        </aside>

        <div class="dashboard-content-v2">
            <div class="profile-card">
                <div class="profile-card__top">
                    <div class="profile-avatar">@initials</div>
                    <div>
                        <h3>@Model.Name</h3>
                        <p>@Model.Email</p>
                    </div>
                    <button type="button" id="toggleEditBtn" class="btn btn-outline-danger ms-auto">Edit Details</button>
                </div>

                <div class="profile-card__grid">
                    <article>
                        <span><i class="fa-solid fa-envelope"></i> Email</span>
                        <p>@Model.Email</p>
                    </article>
                    <article>
                        <span><i class="fa-solid fa-phone"></i> Phone</span>
                        <p>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Add phone number" : Model.Phone)</p>
                    </article>
                    <article>
                        <span><i class="fa-solid fa-location-dot"></i> Address</span>
                        <p>@(string.IsNullOrWhiteSpace(Model.Address) ? "Add address" : Model.Address)</p>
                    </article>
                    <article>
                        <span><i class="fa-solid fa-city"></i> City</span>
                        <p>@(string.IsNullOrWhiteSpace(Model.City) ? "Add city" : Model.City)</p>
                    </article>
                </div>

                @if (TempData["ProfileUpdated"] is string updatedMessage)
                {
                    <p class="profile-update-msg"><i class="fa-solid fa-circle-check"></i> @updatedMessage</p>
                }

                <div id="profileEditPanel" class="profile-edit-panel @(Model.ShowEditForm ? "show" : string.Empty)">
                    <h4>Edit Your Details</h4>
                    <form asp-action="UserDashboard" asp-controller="Home" method="post" class="profile-edit-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                        <div class="form-group">
                            <label asp-for="Name"></label>
                            <input asp-for="Name" class="form-control" placeholder="Your full name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-control" placeholder="you@sweetcake.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Phone"></label>
                            <input asp-for="Phone" class="form-control" placeholder="10 digit phone" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Address"></label>
                            <input asp-for="Address" class="form-control" placeholder="Street, Area" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="City"></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-danger">Save Details</button>
                    </form>
                </div>
            </div>

            <div class="stat-cards">
                <article class="stat-card pink">
                    <h3 id="ordersCount">5</h3>
                    <p>Total Orders</p>
                </article>
                <article class="stat-card cream">
                    <h3 id="wishlistCount">0</h3>
                    <p>Wishlist Items</p>
                </article>
                <article class="stat-card rose">
                    <h3 id="cartCount">0</h3>
                    <p>Cart Items</p>
                </article>
            </div>

            <div class="quick-actions">
                <a href="/Home/Cakes" class="btn btn-danger">Order More Cakes</a>
                <a href="/Home/Checkout" class="btn btn-dark">Go to Checkout</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const wishlist = JSON.parse(localStorage.getItem('wishlist')) || [];
        const cart = JSON.parse(localStorage.getItem('cart')) || [];

        document.getElementById('wishlistCount').textContent = wishlist.length;
        document.getElementById('cartCount').textContent = cart.length;

        const toggleEditBtn = document.getElementById('toggleEditBtn');
        const profileEditPanel = document.getElementById('profileEditPanel');

        toggleEditBtn?.addEventListener('click', () => {
            profileEditPanel?.classList.toggle('show');
        });
    </script>
} *@


@model cake_shop.Models.AppUser
@{
    ViewData["Title"] = "User Dashboard";

    var initials = string.Join("", (Model.Name ?? "")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x[0]))
        .ToUpper();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "";
    }
}

<div class="dashboard-v2">

    <!-- HEADER -->
    <section class="dashboard-head">
        <p class="home-eyebrow">My Account</p>
        <h1>Welcome Back, @Model.Name</h1>
        <p>Manage your profile, orders and settings.</p>

        @* <a asp-action="Logout" asp-controller="Account" class="btn btn-dark mt-2">
            Logout
        </a>

        <a asp-action="ResetPassword" asp-controller="Account" class="btn btn-warning mt-2">
            Reset Password
        </a> *@
    </section>

    <section class="dashboard-grid">

        <!-- MENU -->
        <aside class="dashboard-menu">
            <h4>User Menu</h4>
            <a href="/Home/Cakes">Browse Cakes</a>
            <a href="/Home/Wishlist">Wishlist</a>
            <a href="/Home/Cart">Cart</a>
            <a href="/Home/OrderHistory">
                @* <i class="fa-solid fa-box"></i> Order History *@
                Order History
            </a>
            <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item">
                @* <i class="fa fa-key me-2"></i>  *@
                Change Password
            </a>
            <a href="/Home/Contact">Support</a>
        </aside>

        <!-- CONTENT -->
        <div class="dashboard-content-v2">

            <!-- PROFILE -->
            <div class="profile-card">

                <div class="profile-card__top">
                    <div class="profile-avatar">@initials</div>
                    <div>
                        <h3>@Model.Name</h3>
                        <p>@Model.Email</p>
                    </div>
                </div>

                <!-- DISPLAY -->
                <div class="profile-card__grid">
                    <article><span>Email</span><p>@Model.Email</p></article>
                    <article><span>Phone</span><p>@Model.Phone</p></article>
                </div>

                <!-- EDIT FORM -->
                <h4 class="mt-3">Edit Profile</h4>

                <form asp-action="UserDashboard" method="post">

                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="form-group">
                        <label>Name</label>
                        <input name="Name" value="@Model.Name" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input name="Email" value="@Model.Email" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input name="Phone" value="@Model.Phone" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-danger mt-2">
                        Save Changes
                    </button>

                </form>
            </div>








        </div>
    </section>
</div>




