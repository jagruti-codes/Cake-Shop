@{
}
@model dynamic
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="auth-body">
    <div class="auth-bg-shape auth-bg-shape-one"></div>
    <div class="auth-bg-shape auth-bg-shape-two"></div>

    <main class="auth-shell">
        <section class="auth-card">

            <aside class="auth-brand">
                <p class="brand-chip">Security</p>
                <h1>Change your password</h1>
                <p>Update your password to keep your account secure.</p>
            </aside>

            <section class="auth-form-panel">
                <h2>Change Password</h2>
                <p class="auth-subtitle">Enter your current and new password</p>

                <form asp-action="ChangePassword" method="post" class="auth-form">

                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Current Password</label>
                        <input name="CurrentPassword" type="password" class="form-control auth-input" placeholder="Enter current password" required />
                    </div>

                    <div class="form-group">
                        <label>New Password</label>
                        <input name="NewPassword" type="password" class="form-control auth-input" placeholder="Enter new password" required />
                    </div>

                    <div class="form-group">
                        <label>Confirm New Password</label>
                        <input name="ConfirmPassword" type="password" class="form-control auth-input" placeholder="Confirm new password" required />
                    </div>

                    <button type="submit" class="auth-btn">Update Password</button>

                    @if (TempData["Message"] != null)
                    {
                        <p class="success-msg">@TempData["Message"]</p>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <p class="text-danger">@TempData["Error"]</p>
                    }

                    <p class="switch-auth">
                        Back to
                        <a asp-controller="Home" asp-action="Index" class="auth-link">Home</a>
                    </p>

                </form>
            </section>

        </section>
    </main>
</div>
