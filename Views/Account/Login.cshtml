@model cake_shop.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="auth-body">
    <div class="auth-bg-shape auth-bg-shape-one"></div>
    <div class="auth-bg-shape auth-bg-shape-two"></div>

    <main class="auth-shell">
        <section class="auth-card">
            <aside class="auth-brand">
                <p class="brand-chip">SweetCake Bakery</p>
                <h1>Welcome back to your sweet dashboard.</h1>
                <p>Manage cake orders, customer requests, and daily baking updates in one place.</p>
                <div class="brand-stats">
                    <span>Fresh Bakes Daily</span>
                    <span>Premium Custom Cakes</span>
                </div>
            </aside>

            <section class="auth-form-panel">
                <h2>Sign In</h2>
                <p class="auth-subtitle">Use your account to continue.</p>

                <form asp-action="Login" asp-controller="Account" method="post" class="auth-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-group" style="--delay: .05s;">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control auth-input" placeholder="owner@sweetcake.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group" style="--delay: .12s;">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control auth-input" type="password" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="auth-row" style="--delay: .16s;">
                        <label class="remember-me">
                            <input asp-for="RememberMe" />
                            <span>Keep me signed in</span>
                        </label>
                        <a asp-action="Register" asp-controller="Account" class="auth-link">Create account</a>
                    </div>

                    <button type="submit" class="auth-btn" style="--delay: .2s;">Sign In</button>
                    <div style="display: flex; justify-content: center; margin-top: 12px;">
                        <a asp-action="ForgotPassword" asp-controller="Account" class="auth-link">
                            Forgot Password?
                        </a>
                    </div>
                    @if (TempData["Message"] is string msg)
                    {
                        <p class="success-msg">@msg</p>
                    }
                </form>
            </section>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
