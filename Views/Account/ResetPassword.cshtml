


@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Manrope:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="auth-body">
    <div class="auth-bg-shape auth-bg-shape-one"></div>
    <div class="auth-bg-shape auth-bg-shape-two"></div>

    <main class="auth-shell">
        <section class="auth-card">

            <aside class="auth-brand">
                <p class="brand-chip">Secure Area</p>
                <h1>Reset your password safely</h1>
                <p>Enter OTP and set your new password to regain access.</p>
            </aside>

            <section class="auth-form-panel">
                <h2>Reset Password</h2>
                <p class="auth-subtitle">Verify OTP and create new password</p>

                <form asp-action="ResetPassword" method="post" class="auth-form">
                    <input type="hidden" name="email" value="@ViewBag.Email" />

                    <div class="form-group">
                        <label>OTP Code</label>
                        <input name="otp" class="form-control auth-input" placeholder="Enter 6-digit OTP" />
                    </div>

                    <div class="form-group">
                        <label>New Password</label>
                        <input name="newPassword" type="password" class="form-control auth-input" placeholder="Enter new password" />
                    </div>

                    <button type="submit" class="auth-btn">Reset Password</button>

                    <p class="switch-auth">
                        Back to
                        <a asp-action="Login" asp-controller="Account" class="auth-link">Login</a>
                    </p>
                </form>
            </section>

        </section>
    </main>
</div>
