

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Manrope:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="auth-body">
    <div class="auth-bg-shape auth-bg-shape-one"></div>
    <div class="auth-bg-shape auth-bg-shape-two"></div>

    <main class="auth-shell">
        <section class="auth-card">

            <aside class="auth-brand">
                <p class="brand-chip">Account Recovery</p>
                <h1>Forgot your password?</h1>
                <p>No worries — we’ll send a secure OTP to your email.</p>
            </aside>

            <section class="auth-form-panel">
                <h2>Forgot Password</h2>
                <p class="auth-subtitle">Enter your registered email</p>

                <form asp-action="ForgotPassword" method="post" class="auth-form">

                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" class="form-control auth-input" placeholder="you@example.com" />
                    </div>

                    <button type="submit" class="auth-btn">Send OTP</button>

                    <p class="switch-auth">
                        Remember password?
                        <a asp-action="Login" class="auth-link">Login</a>
                    </p>
                </form>
            </section>

        </section>
    </main>
</div>
