<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SweetCake</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    @RenderSection("Styles", required: false)
</head>

@using System.Text.Json
@using cake_shop.Models

@{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        var isAuthPage = controller == "Account" && (action == "Login" || action == "Register");

        // ✅ GET USER FROM SESSION
        string userJson = Context.Session.GetString("UserProfile");
        UserProfileViewModel user = null;

        if (!string.IsNullOrEmpty(userJson))
        {
                user = JsonSerializer.Deserialize<UserProfileViewModel>(userJson);
        }
}

<body>

    @if (isAuthPage)
    {
        <main>
            @RenderBody()
        </main>
    }
    else
    {
        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">SweetCake</a>

                <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Cakes">Cakes</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>

                    <!-- RIGHT SIDE -->
                    <div class="d-flex align-items-center">

                        <a asp-controller="Home" asp-action="Wishlist" class="me-3">
                            <i class="fa fa-heart"></i>
                        </a>

                        <a asp-controller="Home" asp-action="Cart" class="me-3">
                            <i class="fa fa-shopping-cart"></i>
                        </a>

                        @if (user != null)
                        {
                            <!-- ✅ USER DROPDOWN -->
                            <div class="dropdown">
                                <a class="d-flex align-items-center dropdown-toggle text-decoration-none"
                                   data-bs-toggle="dropdown">

                                    <img src="https://ui-avatars.com/api/?name=@user.Name&background=ff4d6d&color=fff"
                                         width="35" height="35"
                                         class="rounded-circle me-2" />

                                    <strong>@user.Name</strong>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="UserDashboard">
                                            <i class="fa fa-user me-2"></i> My Dashboard
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Orders">
                                            <i class="fa fa-box me-2"></i> My Orders
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Wishlist">
                                            <i class="fa fa-heart me-2"></i> Wishlist
                                        </a>
                                    </li>

                                    <li><hr /></li>

                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fa fa-sign-out-alt me-2"></i> Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- ❌ NOT LOGGED IN -->
                            <a asp-controller="Account" asp-action="Login" class="btn btn-danger ms-2">Login</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-danger ms-2">Register</a>
                        }

                    </div>
                </div>
            </div>
        </nav>

        <main class="container mt-4">
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SweetCake</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    @RenderSection("Styles", required: false)
</head>

@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        var isAuthPage = controller == "Account" && (action == "Login" || action == "Register");

        var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
        var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");
        var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");

        string initials = "";

        if (!string.IsNullOrWhiteSpace(userName))
        {
                initials = string.Join("", userName
                        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Select(x => x[0]))
                        .ToUpper();
        }
}

<body>

    @if (isAuthPage)
    {
        <main>
            @RenderBody()
        </main>
    }
    else
    {
        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    SweetCake
                </a>

                <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">

                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Cakes">Cakes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">

                        <a asp-controller="Home" asp-action="Wishlist" class="me-3">
                            <i class="fa fa-heart"></i>
                        </a>

                        <a asp-controller="Home" asp-action="Cart" class="me-3">
                            <i class="fa fa-shopping-cart"></i>
                        </a>

                        @if (userId != null)
                        {
                            <!-- LOGGED IN USER -->
                            <div class="dropdown">

                                <a class="d-flex align-items-center dropdown-toggle text-decoration-none"
                                   data-bs-toggle="dropdown">

                                    <!-- 🔥 SAME AVATAR AS DASHBOARD -->
                                    <div class="profile-avatar me-2">
                                        @initials
                                    </div>

                                    <strong>@userName</strong>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow">

                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="UserDashboard">
                                            <i class="fa fa-user me-2"></i> Dashboard
                                        </a>
                                    </li>

                                    @if (role == "Admin")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                                <i class="fa fa-shield me-2"></i> Admin Panel
                                            </a>
                                        </li>
                                    }

                                    <li><hr /></li>

                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fa fa-sign-out-alt me-2"></i> Logout
                                        </a>
                                    </li>

                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- NOT LOGGED IN -->
                            <a asp-controller="Account" asp-action="Login" class="btn btn-danger ms-2">
                                Login
                            </a>

                            <a asp-controller="Account" asp-action="Register" class="btn btn-danger ms-2">
                                Register
                            </a>
                        }

                    </div>
                </div>
            </div>
        </nav>

        <main class="container mt-4">
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>


